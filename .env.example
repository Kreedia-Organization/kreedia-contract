# Kreedia Contract Environment Variables
# Copy this file to .env and fill in your values

# Private key for deployment (without 0x prefix)
# Get a test wallet private key - DO NOT use mainnet wallet!
PRIVATE_KEY=your_private_key_here

# Infura API Key (free at infura.io) - for Ethereum testnets
INFURA_API_KEY=your_infura_api_key_here

# BaseScan API Key (optional, for contract verification)
BASESCAN_API_KEY=your_basescan_api_key_here

# Example values (DO NOT USE THESE):
# PRIVATE_KEY=abcdef123456789abcdef123456789abcdef123456789abcdef123456789abcdef
# INFURA_API_KEY=abc123def456ghi789
# BASESCAN_API_KEY=XYZ123ABC456DEF789
